# /etc/default/caldav-automata
# Optional environment overrides for the systemd service.

CONFIG_FILE=/etc/caldav-automata/calendar.yaml
LOG_LEVEL=INFO
LOG_COLOR=never
# NO_COLOR=1
# CALDAV_PASSWORD_FILE is injected by the unit from systemd credentials.
# The calendar config can reference it with: password_file: "${CALDAV_PASSWORD_FILE}"
