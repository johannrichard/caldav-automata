# CalDAV Automata — environment variables
# ----------------------------------------
# Copy this file to .env and fill in your real values.
#
#   cp .env.example .env
#   chmod 600 .env        # keep it readable only by the owning user
#
# NEVER commit .env — it is listed in .gitignore.

# ── Runtime settings ──────────────────────────────────────────────────────────

# Path to the configuration file inside the container.
CONFIG_FILE=/config/calendar.yaml

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Secrets ───────────────────────────────────────────────────────────────────
# Optional fallback: the variable names here must match the ${VAR} references
# in config/calendar.yaml. Prefer password_file + Docker secrets when possible.

# iCloud App-Specific Password
# Generate one at https://appleid.apple.com/account/manage → App-Specific Passwords.
# Never use your regular Apple ID password here.
ICLOUD_PASSWORD=your-app-specific-password-here

# Add further account passwords below, one per account:
# NEXTCLOUD_PASSWORD=your-nextcloud-password-here
