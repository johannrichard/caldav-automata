# CalDAV Automata — environment variables
# ----------------------------------------
# Copy this file to .env and fill in your real values.
#
#   cp .env.example .env
#   chmod 600 .env        # keep it readable only by the owning user
#
# NEVER commit .env — it is listed in .gitignore.

# ── Runtime settings ──────────────────────────────────────────────────────────

# Path to the configuration file inside the container.
CONFIG_FILE=/config/calendar.yaml

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Secrets ───────────────────────────────────────────────────────────────────
# Optional fallback: the variable names here must match the ${VAR} references
# in config/calendar.yaml. Prefer password_file + Docker secrets when possible.

# Primary CalDAV account password / token / app-specific password
# Match this variable name in config/calendar.yaml when using password: "${...}".
CALDAV_PASSWORD=your-caldav-password-here

# Add further account passwords below, one per account:
# TEAM_CALDAV_PASSWORD=your-team-caldav-password-here
